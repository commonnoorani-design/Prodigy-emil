# ─────────────────────────────────────────────────────────────
# Prodigy Educations Mail — copy to .env and fill in
# ─────────────────────────────────────────────────────────────

# Port the app listens on.
PORT=3000

# Optional. The public URL people reach the app on. Leave it blank and each
# request's own address is used, which is right in almost every setup.
APP_URL=

# Optional. Encrypts the mailbox passwords stored in the database. Leave it
# blank and one is generated on first start and kept in data/secret.key.
# Either way, back that value up: lose it and every saved mailbox password
# has to be entered again.
SECRET_KEY=

# First-run administrator. Created only when the database has no users.
# Leave ADMIN_PASSWORD blank to have one generated and printed at startup.
ADMIN_EMAIL=admin@prodigyeducations.com
ADMIN_NAME=Prodigy Administrator
ADMIN_PASSWORD=

# Session + cookie behaviour.
# SECURE_COOKIES=true refuses to send the sign-in cookie over plain HTTP —
# turn it on once your domain serves HTTPS, or sign-in will appear to fail.
SESSION_TTL_HOURS=12
SECURE_COOKIES=false
TRUST_PROXY=true

# Branding used in the header, footer and signatures of every message.
BRAND_NAME=Prodigy Educations
BRAND_TAGLINE=Learning without limits
BRAND_WEBSITE=https://prodigyeducations.com
BRAND_WEBSITE_LABEL=prodigyeducations.com
BRAND_SUPPORT_EMAIL=support@prodigyeducations.com
BRAND_WHATSAPP=+92 330 9829829
BRAND_ESTABLISHED=2020
BRAND_ADDRESS=

# Storage. On a host that replaces the application folder on every deploy, point
# DATA_DIR at somewhere permanent — the database and the uploaded photos follow
# it, so the other two only exist for splitting them up deliberately.
DATA_DIR=./data
# UPLOAD_DIR=./data/uploads
# DB_FILE=./data/prodigy-mail.db

# Upload limits (bytes)
MAX_UPLOAD_BYTES=8388608
MAX_ATTACHMENT_BYTES=20971520

# Only for hosts with a self-signed certificate — leave unset in production.
# IMAP_ALLOW_SELF_SIGNED=1
# SMTP_ALLOW_SELF_SIGNED=1
